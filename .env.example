# Copy to .env.local and fill in values. Never commit .env.local.

# --- Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Required for admin create/update/delete (server-only; never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated admin emails (case-insensitive). Must match an Auth user email.
ADMIN_EMAILS=fortalezafranzandrew53@gmail.com

# Optional: canonical site URL for metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payments (mock checkout — no gateway keys)
